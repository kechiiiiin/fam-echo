# fam-echo relay の設定。これを relay/.env にコピーして埋める（.env は gitignore 済み）
#   cp relay/.env.example relay/.env && chmod 600 relay/.env

# iPhone アプリと共有する合言葉。openssl rand -hex 32 で作る（16文字未満は起動しない）
# 同じ値を ios/Secrets.xcconfig の FAM_ECHO_TOKEN にも入れる
FAM_ECHO_TOKEN=

# Home Assistant の場所と、長期アクセストークンを入れたファイルのパス（中身はここに書かない）
HA_URL=http://localhost:8123
HA_TOKEN_FILE=~/work/home-assistant/.ha-token

# Alexa Media Player の notify サービス名（notify.alexa_media）
HA_NOTIFY_SERVICE=alexa_media

# 読み上げ先（カンマ区切りの entity_id）。空なら HA から Alexa Media Player の media_player を自動で探す
# 例: ECHO_TARGETS=media_player.living_echo,media_player.bedroom_echo
ECHO_TARGETS=

# announce（お知らせ・チャイムつき・全台一斉）か tts（1台ずつ読み上げ）
ECHO_SPEAK_TYPE=announce

# relay が待つ場所（Cloudflare Tunnel からはここへ向ける）
RELAY_HOST=127.0.0.1
RELAY_PORT=8790

# HA を待つ秒数
HA_TIMEOUT=10
