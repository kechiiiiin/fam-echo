# TestFlight 配布の設定。これを Release.local.env にコピーして埋める（Release.local.env は gitignore 済み）
#   cp ios/Release.example.env ios/Release.local.env
# 書式は KEY=値 を1行ずつ。値に引用符は要らない。改行は \n と書く。# で始まる行はコメント。

# --- App Store Connect API キー（ユーザとアクセス → 統合 → App Store Connect API → チームキー） ---
# .p8 は ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 に置く（リポジトリに入れない）
ASC_KEY_ID=
ASC_ISSUER_ID=
# 置き場所を変えたときだけ書く
ASC_KEY_PATH=

# --- TestFlight ---
# 外部テスターのグループ名（無ければ asc.py が作る）
TESTFLIGHT_GROUP=家族
# テスト情報の言語（App Store Connect のロケール。日本語は ja）
BETA_LOCALE=ja

# --- Beta App Review に出すテスト情報（審査担当が読む。値は持ち主が埋める） ---
# 連絡先（審査で問い合わせが来る人）
REVIEW_CONTACT_FIRST_NAME=
REVIEW_CONTACT_LAST_NAME=
REVIEW_CONTACT_EMAIL=
# 国番号つき（例 +81 90 0000 0000）
REVIEW_CONTACT_PHONE=
# 審査担当へのメモ（家の Mac とスピーカーに文を送るアプリで、審査環境では送信先に届かない…など）
REVIEW_NOTES=
# ベータ版の説明（テスターにも見える）
BETA_DESCRIPTION=
# テスターからのフィードバックの宛先
BETA_FEEDBACK_EMAIL=
# プライバシーポリシーの URL（外部テストで求められることがある・推測）
BETA_PRIVACY_POLICY_URL=
# このビルドで試してほしいこと（ビルドごとの「テスト内容」）
WHAT_TO_TEST=
