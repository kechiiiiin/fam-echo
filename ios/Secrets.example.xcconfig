// これを Secrets.xcconfig にコピーして埋める（Secrets.xcconfig は gitignore 済み）
//   cp ios/Secrets.example.xcconfig ios/Secrets.xcconfig
//
// ⚠ xcconfig では「//」以降がコメント扱いになるので、URL の // は「/$()/」と書く。
//   https://fam-echo.example.com  →  https:/$()/fam-echo.example.com
// 末尾の / や /speak は付けない（アプリが /speak を足す）

FAM_ECHO_URL = https:/$()/fam-echo.example.com

// relay/.env の FAM_ECHO_TOKEN と同じ値（openssl rand -hex 32）
FAM_ECHO_TOKEN = ここに64文字の16進

// 名前選択画面に並べる候補（カンマ区切り）。空なら自由入力だけになる
FAM_ECHO_FAMILY = お父さん,お母さん
